root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,md,json,toml}]
indent_size = 2

[*.{kt,kts}]
max_line_length = 120
ij_kotlin_imports_layout = *
ktlint_function_naming_ignore_when_annotated_with = Composable
